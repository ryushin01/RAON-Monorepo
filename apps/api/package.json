{
  "name": "@raon/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PORT=${PORT:-4000} nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc7 --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "db:generate": "drizzle-kit generate",
    "db:reset": "node -e \"require('fs').rmSync('.data/pglite',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.3.2",
    "@raon/contracts": "workspace:*",
    "drizzle-orm": "0.45.4",
    "helmet": "8.3.0",
    "postgres": "3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@raon/config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.0.0",
    "drizzle-kit": "0.31.11",
    "jest": "30.5.2",
    "supertest": "^7.1.0",
    "ts-jest": "29.4.15",
    "typescript": "~7.0.2"
  }
}
