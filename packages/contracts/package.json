{
  "name": "@raon/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc7 -p tsconfig.build.json",
    "dev": "tsc7 -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc7 --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@raon/config": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "typescript": "~6.0.3"
  }
}
