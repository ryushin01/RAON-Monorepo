{
  "name": "raon",
  "version": "0.7.6",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@raon/web",
    "dev:api": "turbo run dev --filter=@raon/api",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check . && yarn lint:css && yarn lint:fsd",
    "lint:fix": "biome check --write . && stylelint --fix \"apps/web/src/**/*.scss\"",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "e2e": "turbo run e2e",
    "storybook": "yarn workspace @raon/web storybook",
    "build-storybook": "yarn workspace @raon/web build-storybook",
    "screenshots": "yarn workspace @raon/web screenshots",
    "lint:fsd": "yarn workspace @raon/web lint:fsd",
    "lint:css": "stylelint \"apps/web/src/**/*.scss\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "stylelint": "^17.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "turbo": "2.11.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.18.1"
}
